# The test expects to run from the repository root.
# Invoke this script with a path, for example ./test/run-tests.
test_dir=$(CDPATH= cd -P "$(dirname "$0")" && pwd -P) || {
    printf '%s\n' 'ERROR: Cannot locate the test directory.' >&2
    exit 2
}
cd "$test_dir/.." || exit 2

test_file=./test/test-sanitize-path.sh
if [ ! -f "$test_file" ] || [ ! -r "$test_file" ]; then
    printf 'ERROR: Cannot read test file: %s\n' "$test_file" >&2
    exit 2
fi

passed=0
failed=0
skipped=0

# Arguments: shell, optional shell arguments, test file.
run_test() {
    if ! command -v "$1" >/dev/null 2>&1; then
        printf 'SKIP: %s is not available\n' "$1"
        skipped=$((skipped + 1))
        return
    fi

    printf '\n=== Running with %s ===\n' "$1"
    # Run the test inside a separate shell process via "$@"
    if "$@"; then
        printf 'PASS: %s\n' "$1"
        passed=$((passed + 1))
    else
        status=$?
        printf 'FAIL: %s (status %s)\n' "$1" "$status" >&2
        failed=$((failed + 1))
    fi
}

run_test /bin/sh "$test_file"
run_test bash "$test_file"
run_test zsh -f "$test_file"

printf '\nShell runs: %s passed, %s failed, %s skipped\n' \
    "$passed" "$failed" "$skipped"

if [ "$failed" -ne 0 ]; then
    exit 1
fi
if [ "$passed" -eq 0 ]; then
    printf '%s\n' 'ERROR: No shell runs were completed.' >&2
    exit 2
fi
exit 0



