#!/bin/sh
# SH FILE: find-py
#
# Purpose   : Find all Python files in specified directory tree.
# Created   : Tuesday, October  8 2024.
# Author    : Pierre Rouleau <prouleau001@gmail.com>
# Time-stamp: <2026-11-13 09:28:20 EST, updated by Pierre Rouleau>
# ----------------------------------------------------------------------------
# Module Description
# ------------------
#
#


# ----------------------------------------------------------------------------
# Dependencies
# ------------
#
#


# ----------------------------------------------------------------------------
# Code
# ----
#
#

error_log="find-perl.log.txt"
pgm_name="${0##*/}"

print_usage()
{
    printf -- "
%s: Find and print the name of every Python file found in directory tree.
           Search for files with the following extensions:
          - .py, .pyw

 Usage: %s -h|--help

  • Print this help information.

 Usage: %s  [DIR, ...]

  • Search and print name of Python files found in specified directories.
    - If DIR is not specified, search in the current working directory.

 ERRORS: All detected errors are appended to the file %s
         stored locally. The file is never deleted.  You must delete it
         manually first if you want to detect new errors.
" "$pgm_name" "$pgm_name" "$pgm_name" "${error_log}"
}

# --
# Check validity of arguments

if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    print_usage
    exit 0
fi

# ----------------------------------------------------------------------------
# shellcheck source=../ibin/xtra/print-utilities.sh
. "$USRHOME_DIR/ibin/xtra/print-utilities.sh"

# --
# Identify the command to use.

if command -v fdfind > /dev/null 2>&1; then
    search_with='fd'
    fd_pgm=fdfind
elif command -v fd > /dev/null 2>&1; then
    search_with='fd'
    fd_pgm=fd
else
    search_with='find'
    case $(uname) in
        Darwin)
            find_path_option='-f'
            ;;
        Linux)
            find_path_option=
            ;;
        *)
            usrhome_printf_error 'find-py: Operating System, %s, is not supported!\n' "$(uname)"
            exit 1
            ;;
    esac
fi

# -----------------------------------------------------------------------------
# Proceed:
#
# -x : do not search into other disks
# stderr redirected to /dev/null to hide warnings trying to access
# non-accessible directories.

search()
{
    # Arg1: dirname : name of directory to search
    case "$search_with" in
        find)
            find -L                               \
                 "${find_path_option}" "$dirname"   \
                 \( -type f -or -type l \)        \
                 \(  -name "*.py"                 \
                 -or -name "*.pyw"                \
                 \) -print 2>> "${error_log}"
            ;;

        fd)
            ${fd_pgm} --absolute-path \
                      --follow           \
                      --type f           \
                      --type l           \
                      -e .py             \
                      -e .pyw            \
                      . "$dirname" 2>> "${error_log}"
            ;;

        *)
            usrhome_printf_error 'find-py: cannot identify find program!\n'
            exit 1
            ;;

        esac
}

if [ -z "$1" ]; then
    dirname="."
    search
else
    for dirname in "$@"; do
        search
    done
fi

# ----------------------------------------------------------------------------
# Local Variables:
# sh-shell: /bin/sh
# End:
