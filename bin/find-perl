#!/usr/bin/env bash
# SH FILE: find-perl
#
# Purpose   : Find all Perl files in specified directory tree.
# Created   : Tuesday, October  8 2024.
# Author    : Pierre Rouleau <prouleau001@gmail.com>
# Time-stamp: <2026-11-15 18:16:47 EST, updated by Pierre Rouleau>
# ----------------------------------------------------------------------------
# Module Description
# ------------------
#
#


# ----------------------------------------------------------------------------
# Dependencies
# ------------
#
#


# ----------------------------------------------------------------------------
# Code
# ----
#
#

error_log="find-perl.log.txt"

print_usage()
{
    printf -- "
find-perl: Find and print the name of every Perl file found in directory tree.
           Search for files with the following extensions:
          - .pl, .pm, .plx, .pls, .xs, .t, .pod, .cgi, .psg, .psgi

 • Usage: find-perl -h|--help

    Print this help information.

 • Usage: find-perl {[-p|--with-system-perl] DIR [DIR ...]
 • Usage: find-perl [-P|--only-system-perl]

  • Search and print name of Perl files found in specified directories.
  • If -p or --with-system-perl:  search the directories that Perl
    identifies in its @INC variable as well as the other directories.
  • if the -P or --only-system-perl option is identified then ONLY
    search the the directories that Perl identifies in its @INC variable.
    When that option is included the DIR arguments are not allowed.
  • This also finds script files that uses a Perl shebang line.
  • The set of files are the scripts, then the pure Perl files are listed..

 ERRORS: All detected errors are appended to the file %s
         stored locally. The file is never deleted.  You must delete it
         manually first if you want to detect new errors.
" "${error_log}"
}

# --
# Check validity of arguments

if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    print_usage
    exit 0
fi

# ----------------------------------------------------------------------------
# shellcheck source=../ibin/xtra/print-utilities.sh
. "$USRHOME_DIR/ibin/xtra/print-utilities.sh"

search_other_directories=true
search_perl_system_directories=false
case ${1-} in
    -p|--with-system-perl)
        search_perl_system_directories=true
        shift
        ;;
    -P|--only-system-perl)
        search_perl_system_directories=true
        search_other_directories=false
        shift
        if [ "$#" -ne 0 ]; then
            usrhome_printf_error 'find-perl: no extra DIR with --only-system-perl
\t Use '\''find-perl -h'\'' to get more information.\n'
            exit 1
        fi
        ;;
esac

if [ "$search_other_directories" = "true" ]; then
    if [ "$#" -eq 0 ]; then
        usrhome_printf_error 'find-perl: at least one directory is required.
\t Use -h to print usage.\n'
        exit 1
    fi
    for dname in "$@"; do
        case $dname in
            *[![:space:]]*) ;;
            *)
                usrhome_printf_error 'find_perl: directory name is empty or whitespace-only.
\t Use -h to print usage.\n'
                exit 1
                ;;
        esac
        if [ ! -d "$dname" ]; then
            usrhome_printf_error 'find-perl: not a valid directory: %s\n' "$dname"
            exit 1
        fi
    done
fi


# --

if command -v fdfind > /dev/null 2>&1; then
    search_with='fd'
    fd_pgm=fdfind
elif command -v fd > /dev/null 2>&1; then
    search_with='fd'
    fd_pgm=fd
else
    search_with='find'
    case $(uname) in
        Darwin)
            find_path_option=(-f)
            ;;
        Linux)
            find_path_option=()
            ;;
        *)
            usrhome_printf_error 'find-perl: Operating System, %s, is not supported!\n' "$(uname)"
            exit 1
            ;;
    esac
fi

# -----------------------------------------------------------------------------
# Proceed:
#
# -x : do not search into other disks
# stderr redirected to /dev/null to hide warnings trying to access
# non-accessible directories.

# --
# Identify the directories to process

declare -a searched_directories
searched_directories=()

# Canonicalize paths before checking directory boundaries.
# The suffix preserves path-ending newlines in command substitution.
canonical_directory()
{
    local path
    path=$(CDPATH='' cd -P -- "$1" >/dev/null && printf '%s.' "$PWD") || return 1
    REPLY=${path%.}
}

if [ "$search_other_directories" = "true" ]; then
    for dname in "$@"; do
        if ! canonical_directory "$dname"; then
            usrhome_printf_error 'find-perl: cannot resolve directory: %s\n' "$dname"
            exit 1
        fi
        searched_directories+=("$REPLY")
    done
fi

if [ "$search_perl_system_directories" = "true" ]; then
    # NUL delimiters preserve spaces and newlines in @INC entries.
    while IFS= read -r -d '' dname; do
        [ -d "$dname" ] || continue
        if ! canonical_directory "$dname"; then
            usrhome_printf_error 'find-perl: cannot resolve directory: %s\n' "$dname"
            exit 1
        fi
        dpath=$REPLY
        found=false
        for d in "${searched_directories[@]}"; do
            if [[ "$d" == / || "$dpath" == "$d" || "$dpath" == "$d/"* ]]; then
                found=true
                break
            fi
        done
        if [ "$found" = "false" ]; then
            searched_directories+=("$dpath")
         fi
    done < <(perl -e 'for (@INC) { print "$_\0" unless ref }')
fi

# --
# Search for shell scripts that use Perl: use rg if available, otherwise use grep.
#
# - Exclude perltidy files, Emacs backup and buffers files.

# Keep the search status if the output filter succeeds.
set -o pipefail
{
# Match direct Perl interpreters and env perl, including env -S perl.
perl_shebang='^#![[:space:]]*([^[:space:]]*/perl|[^[:space:]]*/env[[:space:]]+(-S[[:space:]]+)?perl)([0-9]+([.][0-9]+)*)?([[:space:]]|$)'
if command -v rg > /dev/null 2>&1; then
    for dname in "${searched_directories[@]}"; do
        rg --no-config --color=never --null --hidden --no-ignore --follow -g !'*.tdy' -g !'*~' -g !'*#' -Nl "$perl_shebang" "$dname" 2>> "${error_log}"
    done
else
    # rg is not available; use recursive grep:
    # -l : just list file name
    # -r: recursive
    # -E: extended regular expressions
    # As it might iterate over files that have restricted access: wipe error messages
    for dname in "${searched_directories[@]}"; do
        grep --color=never --null -l --exclude '*.tdy' --exclude '*~' --exclude '*#' -R -E "$perl_shebang" "$dname" 2>> "${error_log}"
    done
fi

# --
# Search the Perl code files. Use fd if available, otherwise use find.
#

search()
{
    # Arg1: dirname : name of directory to search

    case "$search_with" in
        find)
            find -L                        \
                 "${find_path_option[@]}" "$dirname"  \
                 \(  -name "*.p[lm]"       \
                 -or -name "*.pl[sx]"      \
                 -or -name "*.xs"          \
                 -or -name "*.t"           \
                 -or -name "*.pod"         \
                 -or -name "*.cgi"         \
                 -or -name "*.psg"         \
                 -or -name "*.psgi"        \
                 \)  -print0 2>> "${error_log}"
            ;;

        fd)
            "${fd_pgm}" --absolute-path \
                      --hidden           \
                      --no-ignore        \
                      --color=never      \
                      --print0           \
                      --follow           \
                      --type f           \
                      --type l           \
                      -e .pl             \
                      -e .pm             \
                      -e .pls            \
                      -e .plx            \
                      -e .xs             \
                      -e .t              \
                      -e .pod            \
                      -e .cgi            \
                      -e .psg            \
                      -e .psgi           \
                      . "$dirname" 2>> "${error_log}"
            ;;

        *)
            usrhome_printf_error 'find-perl: cannot identify find program!\n'
            exit 1
            ;;
    esac
}


# List Perl files searched in the previously identified directories
for dirname in "${searched_directories[@]}"; do
    search
done
} | perl -0ne '
          BEGIN { binmode STDIN; binmode STDOUT }
          chomp;
          print "$_\n" unless $seen{$_}++;
'
# ----------------------------------------------------------------------------
# Local Variables:
# sh-shell: /bin/bash
# End:
