#!/bin/sh
# SH FILE: rg-f
#
# Purpose   : Ripgrep search for specific file type.
# Created   : Tuesday, June 11 2024.
# Author    : Pierre Rouleau <prouleau001@gmail.com>
# Time-stamp: <2026-11-16 09:29:06 EST, updated by Pierre Rouleau>
# ----------------------------------------------------------------------------
# Module Description
# ------------------
#
# This is a sub-command of ../rgf

# ----------------------------------------------------------------------------
# Code
# ----
#
#

# ----------------------------------------------------------------------------
# shellcheck source=../../ibin/xtra/print-utilities.sh
. "$USRHOME_DIR/ibin/xtra/print-utilities.sh"

# Validate args
case "$1" in
    rg)  cmd=rg   ;;
    rga) cmd=rga  ;;
    *)
        usrhome_printf_error -- "INTERNAL ERROR in rg-f: arg1 is: %s\n" "$1"
        exit 4
        ;;
esac
shift

case "$1" in
    --type=*)
        type="$(echo "$1" | sed 's/--type=//g')"
        shift
        ;;
    *)
    exit 3
esac

case ${type} in
    c)
        ${cmd} -t c "$@"
        ;;

    cpp)
        ${cmd} -t cpp "$@"
        ;;

    c/cpp | C)
        ${cmd} -t c -t cpp "$@"
        ;;

    c/cpp/make | CM)
        ${cmd} -t c -t cpp -t make -t mk -t config -t swig "$@"
        ;;

    d)
        ${cmd} -t d "$@"
        ;;

    dart)
        ${cmd} -t dart "$@"
        ;;

    make | M)
        ${cmd} -t make -t m4 -t mk -t amake -t cmake "$@"
        ;;

    sh)
        ${cmd} -t sh -t zsh  "$@"
        ;;

    elx | elixir)
        ${cmd} -t elixir "$@"
        ;;

    el | elisp)
        ${cmd} -t elisp "$@"
        ;;

    erl | erlang)
        ${cmd} -t erlang -t c "$@"
        ;;

    gl | gleam)
        ${cmd} -t gleam "$@"
        ;;

    go)
        ${cmd} -t go "$@"
        ;;

    lisp)
        ${cmd} -t lisp "$@"
        ;;

    pro | prolog)
        ${cmd} -t prolog "$@"
        ;;

    py | python)
        ${cmd} -t python "$@"
        ;;

    rust)
        ${cmd} -t rust -t toml "$@"
        ;;

    zig)
        ${cmd} -t zig "$@"
        ;;

    doc)
        ${cmd} -t org -t markdown -t readme -t rst -t txt -- "$@"
        ;;

    doc+)
        rga -t org -t markdown -t readme -t rst -t txt -t pdf -- "$@"
        ;;

    pdf)
        rga -t pdf "$@"
        ;;

    html)
        ${cmd} -t html -t css "$@"
        ;;

    *)
        usrhome_printf_error 'rgf ERROR: unsupported TYPE: %s
\t Check %s source:
\t - use the rg --type-list command to identify required command
\t   then add the new code inside the rg-f file.
\t Use -h to print usage.\n' "$type" "$USRHOME_DIR/bin/sub/rg-f"
        exit 2
        ;;

esac

