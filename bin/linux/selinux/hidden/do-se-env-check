# shellcheck source=../../../../ibin/xtra/print-utilities.sh
. "$USRHOME_DIR/ibin/xtra/print-utilities.sh"

# Validate Environment
if [ -z "$USRHOME_SELINUX_POLICY_LOCATION" ]; then
    usrhome_printf_error "SELinux Policy Management Environment is invalid:
\t USRHOME_SELINUX_POLICY_LOCATION environment variable is not set.\n"
    exit 1
fi

#
usrhome_selinux_policy_module_dirpath=
if [ -d "${USRHOME_SELINUX_POLICY_LOCATION}/policy/modules" ]; then
    usrhome_selinux_policy_module_dirpath="${USRHOME_SELINUX_POLICY_LOCATION}/policy/modules"
elif [ -d "${USRHOME_SELINUX_POLICY_LOCATION}/include" ]; then
    ec
    usrhome_selinux_policy_module_dirpath="${USRHOME_SELINUX_POLICY_LOCATION}/include"
fi
if [ "$usrhome_selinux_policy_module_dirpath" = "" ]; then
    usrhome_printf_error "SELinux Policy Management Environment is invalid:
\t - USRHOME_SELINUX_POLICY_LOCATION does not identify a
\t   valid SELinux Reference Policy directory tree.
\t   - USRHOME_SELINUX_POLICY_LOCATION = %s\n" "$USRHOME_SELINUX_POLICY_LOCATION"
    exit 1
fi

