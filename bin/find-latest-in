#!/bin/sh
# SH FILE: find-latest-in
#
# Purpose   : Find and list all new and recently modified files.
# Created   : Wednesday, November 27 2024.
# Author    : Pierre Rouleau <pierre.rouleau@mitel.com>
# Time-stamp: <2026-11-09 16:01:18 EST, updated by Pierre Rouleau>
# ----------------------------------------------------------------------------
# Module Description
# ------------------
#
# Search and list recently created or modified files


# ----------------------------------------------------------------------------
# Dependencies
# ------------
#
# - fd fast searcher:  https://github.com/sharkdp/fd
# - xargs, stat, sort, cut.
#

# ----------------------------------------------------------------------------
# Code
# ----
#
#

print_usage()
{
    printf -- "
find-latest-in: Find and print the name of the recently created and modified files
                in the specified directory tree DIR.

 Usage: find-latest-in  -h|--help

  • Print this help information.

 Usage: find-latest-in [-H|--hidden] [-I|--no-ignore] [-d DIR] [-t TIME] [-f FILEPATTERN]

  • Search and print path-name of all recently created or modified
    files found in the directory tree specified by DIR.
    It searches for all files unless a --file=PATTERN is specified.

    - DIR: Directory tree.  Defaults to current working directory
    - TIME Time within which the files are reported.
      Identify cktime as an integer followed by s, m or h,
      which represent seconds, minutes, hour respectively.
      Defaults to 10m.
    - FILEPATTERN.  Specify a file pattern to search, ignore others.
      By default no pattern is specified and all files are searched.
    - -H | -- hidden: Search hidden files and directories.
      By default they are not searched.
    - -I | --no-ignore: Do not respect the .(git|fd)ignore files.
      By default all ignored files identified by .gitignore or .fdignore
      are ignored.

"
}

# ---
# Define printing utilities:
# - usrhome_printf_warning FORMAT ARGS...
# - usrhome_printf_error   FORMAT ARGS...

# shellcheck source=../ibin/xtra/print-utilities.sh
. "$USRHOME_DIR/ibin/xtra/print-utilities.sh"
# ---

print_error()
{
    usrhome_printf_error 'find-latest-in: %s\n' "$1"
    usrhome_printf_stderr 'Use find-latest-in -h to show usage.\n'
}


# --
# Check validity of arguments, extract options.

opt_hidden=
opt_ignore=
dirname=.
cktime=10m
filepattern=

args=$#
while [ "$args" -ge 1 ]; do
    # echo "Arg1: $1"
    # echo "Arg2: $2"
    case "$1" in
        -h | --help )
            print_usage
            exit 0
            ;;

        -H | --hidden )
            opt_hidden=--hidden
            shift
            ;;

        -I | --no-ignore )
            opt_ignore=--no-ignore
            shift
            ;;

        -d ) dirname="$2"
             shift
             shift
             args=$(( args - 1 ))
             ;;

        -t ) cktime="$2"
             shift
             shift
             args=$(( args - 1 ))
             ;;

        -f ) filepattern="$2"
             shift
             shift
             args=$(( args - 1 ))
             ;;

        *) print_error "Invalid argument $1"
           exit 1
    esac
    args=$(( args - 1 ))
done



# --
# Build options and execute search.

if command -v fd > /dev/null; then
    # Use fd : https://github.com/sharkdp/fd
    # --------------------------------------
    # Build one positional parameter for each fd argument.
    set -- -t f --changed-within "$cktime"

    if [ -n "$opt_hidden" ]; then
        set -- "$@" "$opt_hidden"
    fi

    if [ -n "$opt_ignore" ]; then
        set -- "$@" "$opt_ignore"
    fi

    # Pass the pattern even when it is empty, followed by the search directory.
    set -- "$@" -- "$filepattern" "$dirname"

    case "$(uname)" in
        Darwin)
            fd "$@" | xargs -I '$' ls -l '$'
            ;;

        Linux)
            fd "$@" | xargs -I '$' stat --format '%Y :%y %n' '$' | sort -nr | cut -d: -f2-
            ;;
    esac
    exit "$?"
fi


# Use find when fd is not available
# ---------------------------------

# Use fd when it is available.
platform=$(uname)

case "$platform" in
    Darwin|Linux) ;;
    *)
        print_error "Unsupported operating system: $platform"
        exit 1
        ;;
esac

# find does not implement fd's ignore-file rules.
if [ -z "$opt_ignore" ]; then
    print_error "fd is unavailable. Use -I to search without ignore rules."
    exit 1
fi

# Convert the documented integer duration to seconds.
case "$cktime" in
    *s) unit=1 ;;
    *m) unit=60 ;;
    *h) unit=3600 ;;
    *)
        print_error "Invalid time: $cktime"
        exit 1
        ;;
esac

n=${cktime%?}
case "$n" in
    ''|*[!0-9]*)
        print_error "Invalid time: $cktime"
        exit 1
        ;;
esac

# Remove leading zeroes before shell arithmetic.
n=$(printf '%s\n' "$n" | sed 's/^0*//')
[ -n "$n" ] || n=0

# Keep arithmetic within a conservative range.
if [ "${#n}" -gt 6 ] || [ "$n" -gt 100000 ]; then
    print_error "Time value is too large: $cktime"
    exit 1
fi
seconds=$((n * unit))

# Validate the fallback's regular expression before starting find.
if [ -n "$filepattern" ]; then
    printf '\n' | grep -E -e "$filepattern" >/dev/null 2>&1
    grep_status=$?
    if [ "$grep_status" -gt 1 ]; then
        print_error "Invalid extended regular expression: $filepattern"
        exit 1
    fi
fi

# Use UTC for both date and touch to avoid daylight-saving ambiguity.
case "$platform" in
    Darwin)
        cutoff=$(TZ=UTC0 date -v-"${seconds}"S '+%Y%m%d%H%M.%S') || exit 1
        ;;
    Linux)
        cutoff=$(TZ=UTC0 date -d "$seconds seconds ago" '+%Y%m%d%H%M.%S') || exit 1
        ;;
esac

work=$(mktemp -d "${TMPDIR:-/tmp}/find-latest-in.XXXXXX") || exit 1
trap 'rm -f "$work/stamp" "$work/results"; rmdir "$work"' 0
trap 'exit 1' HUP INT TERM

TZ=UTC0 touch -t "$cutoff" "$work/stamp" || exit 1

# Prevent find from interpreting a relative directory as an expression.
case "$dirname" in
    '') print_error "Directory is empty"; exit 1 ;;
    -*|'!'*|'('* ) dirname="./$dirname" ;;
esac

set -- "$dirname" -mindepth 1

if [ -z "$opt_hidden" ]; then
    # Skip hidden files and do not descend into hidden directories.
    set -- "$@" \( -name '.*' -prune \) -o
fi

# The single-quoted code runs in the child shell, not the current shell.
# shellcheck disable=SC2016
set -- "$@" \( -type f -newer "$work/stamp" -exec sh -c '
    pattern=$1
    platform=$2
    shift 2
    result=0

    for path do
        name=${path##*/}

        if [ -n "$pattern" ]; then
            # Approximate fd smart case: uppercase makes the match sensitive.
            case "$pattern" in
                *[[:upper:]]*)
                    printf "%s\n" "$name" | grep -Eq -e "$pattern"
                    ;;
                *)
                    printf "%s\n" "$name" | grep -Eiq -e "$pattern"
                    ;;
            esac

            status=$?
            [ "$status" -eq 1 ] && continue
            [ "$status" -eq 0 ] || { result=1; continue; }
        fi

        case "$platform" in
            Darwin) ls -l "$path" || result=1 ;;
            Linux) stat --format "%Y :%y %n" -- "$path" || result=1 ;;
        esac
    done

    exit "$result"
' sh "$filepattern" "$platform" '{}' + \)

if ! find "$@" > "$work/results"; then
    print_error "find failed"
    exit 1
fi

case "$platform" in
    Darwin) cat "$work/results" ;;
    Linux) sort -nr "$work/results" | cut -d: -f2- ;;
esac

# ----------------------------------------------------------------------------
#  Local Variables:
#  sh-shell: sh
#  End:
