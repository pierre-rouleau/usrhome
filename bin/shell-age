#!/bin/sh
# SH FILE: shell-age
#
# Purpose   : Print age of shell.
# Created   : Tuesday, June 11 2024.
# Author    : Pierre Rouleau <prouleau001@gmail.com>
# Time-stamp: <2026-11-20 15:16:22 EST, updated by Pierre Rouleau>
# ----------------------------------------------------------------------------
# Description
# -----------
#
#  Print how long the shell has been active.


# ----------------------------------------------------------------------------
# Dependencies
# ------------
#
# The shell configuration file must set the USRHOME_SHELL_OPEN environment
# variables.
#
# - On macOS:  gdate, installed with Homebrew
# - On Linux:  date

# ----------------------------------------------------------------------------
# Code
# ----
#
# shellcheck source=../ibin/xtra/print-utilities.sh
. "$USRHOME_DIR/ibin/xtra/print-utilities.sh"

#
if [ -z "$USRHOME_SHELL_OPEN_DATE" ]; then
    usrhome_printf_error "To use this command, you shell startup script must first
\t initialize USRHOME_SHELL_OPEN_DATE and USRHOME_SHELL_OPEN_TIME environment variables.
\t Add the following lines to that file:
\t  #
\t  USRHOME_SHELL_OPEN_DATE=\$(date)
\t  USRHOME_SHELL_OPEN_TIME=\$(date +%s)
\t  export USRHOME_SHELL_OPEN_DATE
\t  export USRHOME_SHELL_OPEN_TIME
\t  #
\t  exit 1\n"
fi


printf -- "Shell opened: %s\n" "$USRHOME_SHELL_OPEN_DATE"
start_time=${USRHOME_SHELL_OPEN_TIME}

case "$(uname)" in
    Darwin)
        if [ "$USRHOME_USE_HOMEBREW" = "1" ]; then
            if command -v gdate > /dev/null 2>&1; then
                end_time=$(gdate +%s)
                duration=$((end_time - start_time))
                duration_formatted=$(gdate -d@${duration} -u +%Hh%Mm%Ss)
           fi
        fi
        if [ -z "$end_time" ]; then
            usrhome_print_error 'shell-age ERROR: on macOS, gdate must be available; it is not.'
            exit 2
        fi
        ;;

    Linux)
        end_time=$(date +%s)
        duration=$((end_time - start_time))
        duration_formatted=$(date -d@${duration} -u +%Hh%Mm%Ss)
        ;;
esac

days=$((duration / 86400))
printf -- "Shell age   : "
if [ "$days" = "0" ]; then
    printf -- "%s\n" "${duration_formatted}"
elif [ "$days" = "1" ]; then
    printf -- "1 day, %s\n" "${duration_formatted}"
else
    printf -- "%d days, %s\n" "${days}" "${duration_formatted}"
fi


# ----------------------------------------------------------------------------
# Local Variables:
# sh-shell: sh
# End:
