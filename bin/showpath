#!/bin/sh
# SH FILE: showpath
#
# Purpose   : Print current PATH, one directory per line.
# Created   : Monday, March  4 2024.
# Author    : Pierre Rouleau <prouleau001@gmail.com>
# Time-stamp: <2026-11-11 21:42:17 EST, updated by Pierre Rouleau>
#
# ----------------------------------------------------------------------------
# Module Description
# ------------------
#
# Print PATH's elements, one per line.
# Usage: showpath [-n] [[MAN|LIB][PATH]|[[USRHOME_]ORIGINAL[_PATH]]
#
#  -n: when specified, a left justified number is printed on each line.
#
# On error,
# - Print error on stderr.
# - Exit code: 1:  invalid argument(s).
#              2:  specified environment variable is not defined.
#              3:  format of specified environment variable is incorrect.
#
# Examples:
#
#  showpath
#  showpath -n
#  showpath -n PATH
#  showpath LIB
#  showpath LIBPATH
#  showpath -n LIBPATH
#  showpath -n ORIGINAL
#  showpath -n ORIGINAL_PATH
#  showpath -n USRHOME_ORIGINAL_PATH

# ----------------------------------------------------------------------------
# Dependencies
# ------------
#
# printf, sed, nl, tr

# ----------------------------------------------------------------------------
# Code
# ----
#
#
print_usage()
{
    printf "\
showpath: show content of PATH-like environment variable.

 Usage: showpath [-n]  [[INFO|LIB|MAN|<envvar>]|PATH]
        showpath [-h|--help]

    - '-n' : print a numbered list.
    - The other argument identifies the environment variable.
      With noting specified, use PATH.
      Otherwise, use INFO or INFOPATH for INFOPATH, or
                 use LIB or LIBPATH for LIBPATH, or
                 use MAN or MANPATH for MANPATH, or
                 use the name of the environment variable
                 specified as argument.
    - When MANPATH is undefined, showpath displays
      the information provided by manpath (if available).
"
}

# shellcheck source=../ibin/xtra/print-utilities.sh
. "$USRHOME_DIR/ibin/xtra/print-utilities.sh"
# ---

print_error()
{
    usrhome_printf_error 'showpath: %s\n' "$1"
    usrhome_printf_stderr '\tUse showpath -h to see usage.\n'
    exit 1
}

if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    print_usage
    exit 0
fi

numbered='false'
# Parse command line arguments
if [ -n "$2" ]; then
    # there's 2 arguments. Check if one of them is -n
    if [ "$1" = "-n" ]; then
        vname="$2"
        numbered='true'
    else
        print_error "Unsupported option for 2 arguments"
    fi
else
    if [ -z "$1" ]; then
        # No argument
        vname="PATH"
    else
        # 1 argument (or more than 2, but ignore the ones after 2)
        # and don't support -n after the variable name.
        if [ "$1" = "-n" ]; then
            vname="PATH"
            numbered='true'
        else
            vname="$1"
        fi
    fi
fi


# Check separator fields without changing the caller's variables.
showpath_valid_separators() (
    rest=$1
    variable=$2
    if [ "$variable" = MANPATH ] && [ "$rest" = : ]; then
        return 0
    fi
    markers=0
    directories=0
    while :; do
        raw=${rest%%:*}
        entry=${raw#"${raw%%[![:space:]]*}"}
        if [ -z "$entry" ]; then
            # Whitespace-only fields cannot be MANPATH markers.
            [ "$variable" = MANPATH ] && [ -z "$raw" ] || return 1
            markers=$((markers + 1))
            [ "$markers" -le 1 ] || return 1
        else
            directories=$((directories + 1))
        fi
        case "$rest" in
            *:*) rest=${rest#*:} ;;
            *) break ;;
        esac
    done
    [ "$directories" -gt 0 ]
)


show_path()
{
    # vname: string: name of path envvar: PATH, INFOPATH, LIBPATH or MANPATH.
    #                It also supports: ORIGINAL, ORIGINAL_PATH or USRHOME_ORIGINAL_PATH
    #                to show the value of USRHOME_ORIGINAL_PATH
    # numbered: 'true' or 'false'

    case "$vname" in
        ''|[!_abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ]*)
            print_error 'Invalid environment variable name'
            ;;
        *[!_abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789]*)
            print_error 'Invalid environment variable name'
            ;;
    esac

    eval 'path_value=${'"$vname"'-}'

    if [ "$vname" = MANPATH ] && [ "$path_value" = : ]; then
        # A single colon represents the default MANPATH.
        if [ "$numbered" = "true" ]; then
            printf '%s\n' '' | nl -b a -n ln
        else
            printf '%s\n' '- '
        fi
        return 0
    fi

    if [ -z "$path_value" ]; then
        usrhome_printf_warning '%s is not defined!\n' "$vname"
        if [ "$vname" = "MANPATH" ]; then
            if command -v manpath > /dev/null 2>&1; then
                if [ -n "$(manpath)" ]; then
                    printf -- " However the manpath command provides the list:\n" >&2
                    if [ "$numbered" = "true" ]; then
                        manpath | tr ':' '\n' | nl -b a -n ln
                    else
                        printf -- "- "
                        manpath | sed 's/:/:- /g' | tr ':' '\n'
                    fi
                    exit 0
                fi
            fi
        fi
        exit 2
    else
        if [ "$numbered" = "true" ]; then
            printf -- "%s\n" "$path_value" | tr ':' '\n' | nl -b a -n ln
        else
            printf -- "- "
            printf -- "%s\n" "$path_value" | sed 's/:/:- /g' | tr ':' '\n'
        fi
        if ! showpath_valid_separators "$path_value" "$vname"; then
            usrhome_printf_error '%s has invalid empty entries!\n' "$vname"
            usrhome_printf_stderr 'The value is: %s\n' "$path_value"
            exit 3
        fi
    fi
}

# Map shortcut names to variable names. show_path validates each name
# before the indirect expansion.
case $vname in
    'INFO'|'INFOPATH')
        vname="INFOPATH"
        ;;

    'LIB'|'LIBPATH')
        vname="LIBPATH"
        ;;

    'MAN'|'MANPATH')
        vname="MANPATH"
        ;;

    'ORIGINAL' | 'ORIGINAL_PATH' | 'USRHOME_ORIGINAL_PATH')
        vname="USRHOME_ORIGINAL_PATH"
        ;;
esac
show_path

# ----------------------------------------------------------------------------
