#!/bin/sh
# SH FILE: lint-sh
#
# Purpose   : Lint shells scripts - check for issues with cd.
# Created   : Friday, November 13 2026.
# Author    : Pierre Rouleau <prouleau001@gmail.com>
# Time-stamp: <2026-11-18 11:07:12 EST, updated by Pierre Rouleau>
# ----------------------------------------------------------------------------
# Module Description
# ------------------
#
#  Scans shell scripts for risky 'cd' usage and other issues
#  that ShellCheck may miss.  Also execute ShellCheck on request.
#

# ----------------------------------------------------------------------------
# Dependencies
# ------------
#
#

# ----------------------------------------------------------------------------
# Code
# ----
#
#

pgm_name="${0##*/}"
user_cwd="$PWD"

print_usage()
{
    printf -- "\
%s -- Scans shell scripts for risky cd usage that ShellCheck may miss.

 • Usage: %s -h|--help

    Print this help information.

 • Usage: %s [-s|-S] [-q|-v] [-x] -f FILE | -d DIRECTORY

    Scans a single shell script or all shell scripts (.sh, .bash, .zsh, files
    with shell shebangs, or files with sourced shell script markers) inside a
    directory for missing \"--\" end-of-options delimiters on POSIX utilities
    and risky \"cd\" patterns.

   Checks performed:
     - Missing \"--\" end-of-options delimiter
     - Bare relative paths vulnerable to CDPATH side effects
     - Unguarded variable prefixes (e.g., \"\$VAR/sub\" instead of \"\${VAR:?}/sub\")
     - Unchecked exit statuses (missing ||, &&, or conditional guards)

   Arguments:
    -f FILE       Audit a single shell script file
    -d DIRECTORY  Recursively audit all shell scripts inside DIRECTORY

   Options:
    -s            Execute a shellcheck style check on each file and print
                  the number of detected issues.
    -S            Execute a shellcheck style check on each file and print
                  the detected issues.
    -q            Quiet: ignore parsing limitation, do not report nor count
                  them.
    -v            Verbose: show all warnings for diagnostics that cannot be
                  analyzed by the current lexer instead of only showing
                  the warning count detected on each file.
    -x            Exit fast from shellcheck detected errors: stop after reporting
                  errors in one file, by default report errors in all files.
                  This has no impact on detection of other checks.

   Examples:
    %s -f /path/to/usrhome/bin/script.sh
    %s -d /path/to/usrhome

   LIMITATIONS:
     %s cannot analyze some code constructs and skips them issuing a warning
     when the -v option is specified.  Each warning line printed by %s
     starts with 'WARNING: '.
     - If you want to only see the detected issues you can filter the warnings
      by piping the output of %s into:  grep -v \": \\[WARNING: \"
     - If you want to only see the ShellCheck error count for all files under
       the current directory tree, you can use the following command:
       \"%s -s -d . | grep SHELLCHECK\"
" "$pgm_name" "$pgm_name" "$pgm_name" "$pgm_name" "$pgm_name" \
  "$pgm_name" "$pgm_name" "$pgm_name" "$pgm_name"
}

# --
# validate arguments

# Print usage and exit if no arguments are supplied
if [ $# -eq 0 ]; then
    print_usage
    exit 1
fi

if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    print_usage
    # help requested explicitly: no error.
    exit 0
fi

# ----------------------------------------------------------------------------
# shellcheck source=../ibin/xtra/print-utilities.sh
. "$USRHOME_DIR/ibin/xtra/print-utilities.sh"

target_file=''
target_dir=''

report_limitations=1
verbose=0
q_v_seen=''

with_shellcheck=0
with_shellcheck_count=0
exit_fast=0

while [ $# -gt 0 ]; do
    case "$1" in
        -f|--file)
            if [ $# -lt 2 ] || [ -z "$2" ]; then
                usrhome_printf_error '%s requires a file argument.\n' "$pgm_name"
                exit 1
            fi
            target_file=$2
            shift 2
            ;;
        -d|--directory)
            if [ $# -lt 2 ] || [ -z "$2" ]; then
                usrhome_printf_error '%s requires a directory argument.\n' "$pgm_name"
                exit 1
            fi
            target_dir=$2
            shift 2
            ;;
        -S)
            if command -v shellcheck > /dev/null 2>&1; then
                with_shellcheck=1
            else
                usrhome_printf_warning '%s: shellcheck requested but not available: not used!\n' "$pgm_name"
            fi
            shift
            ;;
        -s)
            if command -v shellcheck > /dev/null 2>&1; then
                with_shellcheck=1
                with_shellcheck_count=1
            else
                usrhome_printf_warning '%s: shellcheck requested but not available: not used!\n' "$pgm_name"
            fi
            shift
            ;;
        -q)
            if [ "$q_v_seen" = "v" ]; then
                usrhome_printf_error '%s: Cannot use the -q and -v options together.\n' "$pgm_name"
                exit 1
            fi
            q_v_seen="q"
            report_limitations=0
            shift
            ;;
        -v)
            if [ "$q_v_seen" = "v" ]; then
                usrhome_printf_error '%s: Cannot use the -q and -v options together.\n' "$pgm_name"
                exit 1
            fi
            q_v_seen="v"
            verbose=1
            shift
            ;;
        -x)
            exit_fast=1
            shift
            ;;
        --)
            shift
            break
            ;;
        -*)
            usrhome_printf_error '%s: Unknown option: %s
\t Use the -h option to print usage.\n' "$pgm_name" "$1"
            exit 1
            ;;
        *)
            usrhome_printf_error '%s: Unexpected argument: %s
\t Use the -h option to print usage.\n' "$pgm_name" "$1"
            exit 1
            ;;
    esac
done

# Reject no target
if [ -z "$target_file" ] && [ -z "$target_dir" ]; then
    usrhome_printf_error '%s: No FILE or DIRECTORY specified.
\t Use the -h option to print usage.\n' "$pgm_name"
    exit 1
fi

# Reject extra positional arguments or both -f and -d used together
if [ -n "$target_file" ] && [ -n "$target_dir" ]; then
    usrhome_printf_error '%s: Specify either -f FILE or -d DIRECTORY, not both.
\t Use the -h option to print usage.\n' "$pgm_name"
    exit 1
fi

# Reject invalid targets
if [ -n "$target_file" ]; then
    if [ ! -f "$target_file" ]; then
        usrhome_printf_error '%s: File not found: %s\n' "$pgm_name" "$target_file"
        exit 1
    fi
elif [ -n "$target_dir" ]; then
    if [ ! -d "$target_dir" ]; then
        usrhome_printf_error '%s: Directory not found: %s\n' "$pgm_name" "$target_dir"
        exit 1
    fi
fi

# --
# Identify the complete path of the shellcheck, wc and tr utilities used
# during auditing.  Prevent the auditing to change them.

# Resolve executable paths before changing to any audited directory.
resolve_executable()
{
    resolved_command=$(command -v "$1") || return 1
    case $resolved_command in
        /*) ;;
        *)
            # Preserve trailing newlines in the current directory name.
            resolve_dir=$(pwd -P && printf '.') || return 1
            resolve_dir=${resolve_dir%.}
            resolve_dir=${resolve_dir%?}
            resolved_command=${resolve_dir%/}/$resolved_command
            ;;
    esac
    [ -f "$resolved_command" ] && [ -x "$resolved_command" ] || return 1
    printf '%s\n' "$resolved_command"
}

if [ "$with_shellcheck" = "1" ]; then
    if ! shellcheck_pgm=$(resolve_executable shellcheck); then
        printf '%s: cannot resolve the shellcheck executable.\n' "$pgm_name" >&2
        exit 1
    fi
    if [ "$with_shellcheck_count" = "1" ]; then
        if ! wc_pgm=$(resolve_executable wc) ||
                ! tr_pgm=$(resolve_executable tr); then
            printf '%s: cannot resolve the wc or tr executable.\n' "$pgm_name" >&2
            exit 1
        fi
    elif ! awk_pgm=$(resolve_executable awk); then
        printf '%s: cannot resolve the awk executable.\n' "$pgm_name" >&2
        exit 1
    fi
fi

# --
# Define the operations

terminate_processing=0
audit_file()
{
    file=$1

    if [ "$with_shellcheck" = "1" ]; then
        # extract file basename and directory
        f_name="${file##*/}"
        case "$file" in
            */*) d_name="${file%/*}" ;;
            *)   d_name="." ;;
        esac
        # Execute shellcheck in a sub-shell inside the directory of the checked file
        # this way shellcheck will be able to use the shellcheck source statements
        # to identify the location of the source files like Emacs is able to do it.
        (
            CDPATH='' cd -- "$d_name" || return 1
            if [ "$with_shellcheck_count" = "1" ]; then
                error_count="$("$shellcheck_pgm" -x -S style --format=gcc  "$PWD/$f_name" |  "$wc_pgm" -l | "$tr_pgm" -d ' ')"
                if [ "$error_count" -gt 0 ]; then
                    printf '%s: SHELLCHECK %s diagnostics\n' "$file" "$error_count"
                    if [ "$exit_fast" = "1" ]; then
                        return 1
                    fi
                fi
            else
                output="$("$shellcheck_pgm" -x -S style --format=gcc "$PWD/$f_name")"
                status=$?
                # remove the user's CWD path from the path of each file in the output message
                if [ -n "$output" ]; then
                    printf '%s\n' "$output" | "$awk_pgm" -v prefix="$user_cwd" '
                        index($0, prefix) == 1 {
                                print substr($0, length(prefix) + 1)
                                next
                        }
                        {
                           print
                        }'
                fi
                if [ "$status" -ne 0 ]; then
                    if [ "$exit_fast" = "1" ]; then
                       return 1
                   fi
                fi
            fi
        ) || terminate_processing=1
    fi


    # Keep the original filename for diagnostics.  Prefix relative input
    # paths so AWK cannot mistake them for assignments or options.
    # This is done to prevent AWK from mistaking a file named 'abc=def'
    # as a flag assignment.
    case "$file" in
        /*) awk_file=$file ;;
        *)  awk_file=./$file ;;
    esac

    if [ "$verbose" = "1" ]; then
        LC_ALL=C "$awk_pgm" -v fname="$file" -f "$USRHOME_DIR/bin/other/lint-sh.awk" "$awk_file"
    else
        LC_ALL=C "$awk_pgm" -v fname="$file" -v hide_unsupported="1"  -f "$USRHOME_DIR/bin/other/lint-sh.awk" "$awk_file"
    fi

}

# --
# Proceed with identified, valid targets

# Resolve the physical path of this script so it skips itself during directory scans
self_dir=$(CDPATH='' cd -P -- "$(dirname -- "$0")" 2>/dev/null && pwd -P)
self_path="$self_dir/$(basename -- "$0")"

lint_error_found=0

if [ -n "$target_file" ]; then
    # Audit the specified file
    #
    if ! audit_file "$target_file"; then
        if [ "$report_limitations" = "1" ]; then
            lint_error_found=1
        fi
    fi

elif [ -n "$target_dir" ]; then
    # Audit all shell script in specified directory.
    #
    # Save the file list so the find status is not hidden by a pipeline.
    file_list=$(mktemp "${USRHOME_DIR_TMP:-${TMPDIR:-/tmp}}/lint-sh.XXXXXXXXXX") || {
        printf '%s: cannot create temporary file list\n' "$pgm_name" >&2
        exit 1
    }
    trap 'rm -f -- "$file_list"' 0
    trap 'exit 1' HUP INT TERM

    if ! find "$target_dir" -type f ! -name '.DS_Store' ! -path '*/.git/*' > "$file_list"; then
        lint_error_found=2
    fi
    {
        while IFS= read -r file; do
            # Skip scanning the auditor script itself
            file_dir=$(CDPATH='' cd -P -- "$(dirname -- "$file")" 2>/dev/null && pwd -P)
            if [ "$file_dir/$(basename -- "$file")" = "$self_path" ]; then
                continue
            fi
            # Only inspect files with a shell extension or a shell shebang
            case "$file" in
                *.sh|*.bash|*.zsh) is_shell=1 ;;

                *)
                    # Prefix relative paths so file does not treat them as options.
                    case "$file" in
                        /*) probe_file=$file ;;
                        *)  probe_file=./$file ;;
                    esac

                    if ! file_type=$(LC_ALL=C file -b "$probe_file" 2>/dev/null); then
                        printf '%s: cannot classify %s\n' "$pgm_name" "$file" >&2
                        lint_error_found=3
                        continue
                    fi

                    case "$file_type" in
                        ELF*|Mach-O*|PE32*)
                            continue
                            ;;
                        'cannot open'*|'cannot read'*)
                            printf '%s: cannot classify %s: %s\n' \
                                   "$pgm_name" "$file" "$file_type" >&2
                            lint_error_found=4
                            continue
                            ;;
                    esac

                    # Prefix the result with T for text or N for a NUL-byte offset.
                    # Convert through od so no NUL reaches command substitution.
                    first_line_result=$(
                        head -n 1 "$file" 2>/dev/null |
                            LC_ALL=C od -A n -t u1 -v |
                            LC_ALL=C awk '
            BEGIN { status = "T"; offset = 0 }
            {
                for (i = 1; i <= NF; i++) {
                    if (done) continue
                    byte = $i + 0
                    if (byte == 10) {
                        done = 1
                    } else if (byte == 0) {
                        status = "N"
                        done = 1
                    } else {
                        text = text sprintf("%c", byte)
                        offset++
                    }
                }
            }
            END {
                if (status == "N") printf "N%.0f", offset
                else printf "T%s", text
            }
        '
                                     )

                    case "$first_line_result" in
                        N*)
                            offset=${first_line_result#N}
                            printf '%s:1: [WARNING: NUL byte at byte column %s (zero-based file offset %s); file skipped]\n' \
                                   "$file" "$((offset + 1))" "$offset" >&2
                            continue
                            ;;
                        T*)
                            first_line=${first_line_result#T}
                            ;;
                        *)
                            printf '%s: [ERROR: could not inspect first line]\n' "$file" >&2
                            lint_error_found=5
                            continue
                            ;;
                    esac
                    case "$first_line" in
                        # Match shell path in the shebang line
                        '#!'*/sh*|'#!'*/bash*|'#!'*/zsh*|'#!'*' env sh'*|'#!'*' env bash'*|'#!'*' env zsh'*)
                            is_shell=1 ;;
                        *)
                            # Match env followed by a shell name, with
                            # optional -S and shell arguments.
                            if printf '%s\n' "$first_line" |
                                    grep -Eq \
                                         '^#![[:blank:]]*/([^[:blank:]]*/)?env[[:blank:]]+(-S[[:blank:]]+)?(sh|bash|zsh)([[:blank:]]|$)'
                            then
                                is_shell=1
                            else
                                if printf '%s\n' "$first_line" |
                                        grep -Eq \
                                             '^[[:blank:]]*#[[:blank:]]*Sourced[[:blank:]]+script:.*-\*-[[:blank:]]*mode:[[:blank:]]*(sh|bash|zsh)[[:blank:]]*;[[:blank:]]*-\*-'
                                then
                                    is_shell=1
                                else
                                    is_shell=0
                                fi
                            fi
                            ;;
                    esac
                    ;;
            esac
            if [ "$is_shell" -eq 1 ]; then
                if ! audit_file "$file"; then
                    if [ "$terminate_processing" = "1" ]; then
                        exit 1
                    fi
                    if [ "$report_limitations" = "1" ]; then
                        lint_error_found=1
                    fi
                fi
            fi
        done
} < "$file_list"
fi

exit "$lint_error_found"

# ----------------------------------------------------------------------------
# Local Variables:
# sh-shell: zsh
# End:
