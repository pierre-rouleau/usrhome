#!/bin/sh
# SH FILE: lint-sh
#
# Purpose   : Lint shells scripts - check for issues with cd.
# Created   : Friday, November 13 2026.
# Author    : Pierre Rouleau <prouleau001@gmail.com>
# Time-stamp: <2026-11-20 09:39:13 EST, updated by Pierre Rouleau>
# ----------------------------------------------------------------------------
# Module Description
# ------------------
#
#  Scans shell scripts for risky 'cd' usage and other issues
#  that ShellCheck may miss.  Also execute ShellCheck on request.
#

# ----------------------------------------------------------------------------
# Dependencies
# ------------
#
#

# ----------------------------------------------------------------------------
# Code
# ----
#
#

pgm_name="${0##*/}"
user_cwd="$PWD"

print_usage()
{
    printf -- "\
%s -- Scans shell scripts for risky cd usage that ShellCheck may miss.

 • Usage: %s -h|--help

    Print this help information.

 • Usage: %s [-s|-S] [-q|-v] [-x] -f FILE | -d DIRECTORY

    Scans a single shell script or all shell scripts (.sh, .bash, .zsh, files
    with shell shebangs, or files with sourced shell script markers) inside a
    directory for missing \"--\" end-of-options delimiters on POSIX utilities
    and risky \"cd\" patterns.

   Checks performed:
     - Missing \"--\" end-of-options delimiter
     - Bare relative paths vulnerable to CDPATH side effects
     - Unguarded variable prefixes (e.g., \"\$VAR/sub\" instead of \"\${VAR:?}/sub\")
     - Unchecked exit statuses (missing ||, &&, or conditional guards)

   Arguments:
    -f FILE       Audit a single shell script file
    -d DIRECTORY  Recursively audit all shell scripts inside DIRECTORY

   Options:
    -s            Execute a shellcheck style check on each file and print
                  the number of detected issues.
    -S            Execute a shellcheck style check on each file and print
                  the detected issues.
    -q            Quiet: suppress individual parsing limitation reports.
                  Include their counts in the final summary, but ignore them
                  for the exit status.
    -v            Verbose: show all warnings for diagnostics that cannot be
                  analyzed by the current lexer instead of only showing
                  the warning count detected on each file.
    -x            Exit fast from shellcheck detected errors: stop after reporting
                  errors in one file, by default report errors in all files.
                  This has no impact on detection of other checks.

   Examples:
    • %s -f /path/to/usrhome/bin/script.sh
    • %s -d /path/to/usrhome

    • To process all script files in the current directory tree, checking them
      with shellcheck and showing the shellcheck message and check with the
      extra rules imposed by %s without showing its limitations and stopping
      on the first file that has an identifiable issue (either detected by
      shellcheck or %s own rules), and return with an exit code 0 if no error
      found or 1 otherwise, do this:

      • %s -d . -S -q -x

   SKIPPED:
    The following files and directories are skipped when the execution is
    done for a directory tree as requested by the -d option:
    - Emacs backup and temporary files.
    - Text, reStructuredText, Markdown, Org files.
    - C, C++, C3, Common Lisp, D, Elixir, Emacs Lip, Erlang, Gleam , Go,
    - Haskell, Java, Javascript, Julia, LFE, Lua, M4, Modula, Mojo,
    - NetREXX, Nim, OCaml, ObjectiveC, Odin, PHP, Pascal, Perl, Pony,
    - Prolog, Purescript, Python, R, Racket, ReasonML, REXX, Rebol, Red, Rocq,
    - Ruby, Rust, Scheme, Seed7, Shen, Swift, Tcl, Typescript, Vala,
    - Zig programming languages.
    - DVCS directory trees for: Git (.git), Jujutsu (.jj), Mercurial (.hg),
      GNU Bazar (.bzr), Darcs (_darcs), Game of Trees (.got), Pijul (.pijul),
      Unity VCS (.plastic).
    - man/man[0-9] directories.
    The operation requested for a -f option always perform the audit of the
    identified file.
    Note that even when a file is not explicitly skipped, the scan checks if
    it is a real shell script before auditing it, non shell script files are
    not audited.  The explicit skipping of files and directories is only done
    to speed up overall processing of large directory trees.

   LIMITATIONS:
     %s cannot analyze some code constructs and skips them issuing a warning
     when the -v option is specified.  Each warning line printed by %s
     starts with 'WARNING: '.
     - If you want to only see the ShellCheck error count for all files under
       the current directory tree, you can use the following command:
       \"%s -s -d . | grep SHELLCHECK\"
" "$pgm_name" "$pgm_name" "$pgm_name" "$pgm_name" "$pgm_name" \
  "$pgm_name" "$pgm_name" "$pgm_name" "$pgm_name" "$pgm_name" "$pgm_name"
}

# --
# validate arguments

# Print usage and exit if no arguments are supplied
if [ $# -eq 0 ]; then
    print_usage
    exit 1
fi

if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    print_usage
    # help requested explicitly: no error.
    exit 0
fi

# ----------------------------------------------------------------------------
# shellcheck source=../ibin/xtra/print-utilities.sh
. "$USRHOME_DIR/ibin/xtra/print-utilities.sh"

target_file=''
target_dir=''

report_limitations=1
verbose=0
q_v_seen=''

with_shellcheck=0
with_shellcheck_count=0
exit_fast=0

while [ $# -gt 0 ]; do
    case "$1" in
        -f|--file)
            if [ $# -lt 2 ] || [ -z "$2" ]; then
                usrhome_printf_error '%s requires a file argument.\n' "$pgm_name"
                exit 1
            fi
            target_file=$2
            shift 2
            ;;
        -d|--directory)
            if [ $# -lt 2 ] || [ -z "$2" ]; then
                usrhome_printf_error '%s requires a directory argument.\n' "$pgm_name"
                exit 1
            fi
            target_dir=$2
            shift 2
            ;;
        -S)
            if command -v shellcheck > /dev/null 2>&1; then
                with_shellcheck=1
            else
                usrhome_printf_warning '%s: shellcheck requested but not available: not used!\n' "$pgm_name"
            fi
            shift
            ;;
        -s)
            if command -v shellcheck > /dev/null 2>&1; then
                with_shellcheck=1
                with_shellcheck_count=1
            else
                usrhome_printf_warning '%s: shellcheck requested but not available: not used!\n' "$pgm_name"
            fi
            shift
            ;;
        -q)
            if [ "$q_v_seen" = "v" ]; then
                usrhome_printf_error '%s: Cannot use the -q and -v options together.\n' "$pgm_name"
                exit 1
            fi
            q_v_seen="q"
            report_limitations=0
            shift
            ;;
        -v)
            if [ "$q_v_seen" = "q" ]; then
                usrhome_printf_error '%s: Cannot use the -q and -v options together.\n' "$pgm_name"
                exit 1
            fi
            q_v_seen="v"
            verbose=1
            shift
            ;;
        -x)
            exit_fast=1
            shift
            ;;
        --)
            shift
            break
            ;;
        -*)
            usrhome_printf_error '%s: Unknown option: %s
\t Use the -h option to print usage.\n' "$pgm_name" "$1"
            exit 1
            ;;
        *)
            usrhome_printf_error '%s: Unexpected argument: %s
\t Use the -h option to print usage.\n' "$pgm_name" "$1"
            exit 1
            ;;
    esac
done

# Reject no target
if [ -z "$target_file" ] && [ -z "$target_dir" ]; then
    usrhome_printf_error '%s: No FILE or DIRECTORY specified.
\t Use the -h option to print usage.\n' "$pgm_name"
    exit 1
fi

# Reject extra positional arguments or both -f and -d used together
if [ -n "$target_file" ] && [ -n "$target_dir" ]; then
    usrhome_printf_error '%s: Specify either -f FILE or -d DIRECTORY, not both.
\t Use the -h option to print usage.\n' "$pgm_name"
    exit 1
fi

# Reject invalid targets
if [ -n "$target_file" ]; then
    if [ ! -f "$target_file" ]; then
        usrhome_printf_error '%s: File not found: %s\n' "$pgm_name" "$target_file"
        exit 1
    fi
elif [ -n "$target_dir" ]; then
    if [ ! -d "$target_dir" ]; then
        usrhome_printf_error '%s: Directory not found: %s\n' "$pgm_name" "$target_dir"
        exit 1
    fi
fi

# --
# Identify the complete path of the shellcheck, wc and tr utilities used
# during auditing.  Prevent the auditing to change them.

# Resolve executable paths before changing to any audited directory.
resolve_executable()
{
    resolved_command=$(command -v "$1") || return 1
    case $resolved_command in
        /*) ;;
        *)
            # Preserve trailing newlines in the current directory name.
            resolve_dir=$(pwd -P && printf '.') || return 1
            resolve_dir=${resolve_dir%.}
            resolve_dir=${resolve_dir%?}
            resolved_command=${resolve_dir%/}/$resolved_command
            ;;
    esac
    [ -f "$resolved_command" ] && [ -x "$resolved_command" ] || return 1
    printf '%s\n' "$resolved_command"
}

if ! awk_pgm=$(resolve_executable awk); then
    printf '%s: cannot resolve the awk executable.\n' "$pgm_name" >&2
    exit 1
fi
if [ "$with_shellcheck" = "1" ]; then
    if ! shellcheck_pgm=$(resolve_executable shellcheck); then
        printf '%s: cannot resolve the shellcheck executable.\n' "$pgm_name" >&2
        exit 1
    fi
    if ! wc_pgm=$(resolve_executable wc) ||
            ! tr_pgm=$(resolve_executable tr); then
        printf '%s: cannot resolve the wc or tr executable.\n' "$pgm_name" >&2
        exit 1
    fi
fi

# The statistics file is shared by sequential AWK invocations.
stats_file=$(mktemp "${USRHOME_DIR_TMP:-${TMPDIR:-/tmp}}/lint-sh-stats.XXXXXXXXXX") || {
    printf '%s: cannot create temporary statistics file\n' "$pgm_name" >&2
    exit 1
}
file_list=''
trap 'rm -f -- "$stats_file"; if [ -n "$file_list" ]; then rm -f -- "$file_list"; fi' 0
trap 'exit 1' HUP INT TERM

files_to_audit=0
files_audited=0
internal_diagnostics=0
shellcheck_diagnostics=0
unsupported_files=0
unsupported_diagnostics=0

# --
# Define the operations

terminate_processing=0
audit_file()
{
    # Return value:
    #  - 0 audit succeeds
    #  - 1 Shellcheck and awk audit done.  At least 1 shellcheck diag found.
    #  - 2 Shellcheck attempted and failed.
    #  - 3 Shellcheck done, but no awk based scan done.
    #  - 4 Shellcheck done, but awk based scan attempted and failed.

    file=$1
    shellcheck_diags_found=0

    if [ "$with_shellcheck" = "1" ]; then
        # Run in the file's directory so ShellCheck can resolve sources.
        f_name="${file##*/}"
        case "$file" in
            */*) d_name="${file%/*}" ;;
            *)   d_name="." ;;
        esac
        shellcheck_output=$(
            CDPATH='' cd -- "$d_name" || exit 2
            "$shellcheck_pgm" -x -S style --format=gcc "$PWD/$f_name"
                         )
        shellcheck_status=$?

        case $shellcheck_status in
            0|1)
                if [ "$shellcheck_status" -eq 1 ]; then
                    shellcheck_diags_found=1
                    if [ "$exit_fast" = "1" ]; then
                        terminate_processing=1
                    fi
                fi
                if [ -n "$shellcheck_output" ]; then
                    file_shellcheck_count=$(
                        printf '%s\n' "$shellcheck_output" |
                            "$wc_pgm" -l | "$tr_pgm" -d ' '
                                         )
                    shellcheck_diagnostics=$((shellcheck_diagnostics + file_shellcheck_count))
                    if [ "$with_shellcheck_count" = "1" ]; then
                        printf '%s: SHELLCHECK %s diagnostics\n' "$file" "$file_shellcheck_count"
                    else
                        # Remove the user's CWD prefix from diagnostic paths.
                        printf '%s\n' "$shellcheck_output" | "$awk_pgm" -v prefix="$user_cwd/" '
                                         index($0, prefix) == 1 {
                                             print substr($0, length(prefix) + 1)
                                             next
                                         }
                                         { print }'
                    fi
                fi
                ;;
            *)
                printf '%s: ShellCheck failed for %s (status %s)\n' \
                 "$pgm_name" "$file" "$shellcheck_status" >&2
                shellcheck_failed=1
                if [ "$exit_fast" = "1" ]; then
                    terminate_processing=1
                fi
                ;;
        esac
    fi

    # Keep the original filename for diagnostics.  Prefix relative input
    # paths so AWK cannot mistake them for assignments or options.
    # This is done to prevent AWK from mistaking a file named 'abc=def'
    # as a flag assignment.
    case "$file" in
        /*) awk_file=$file ;;
        *)  awk_file=./$file ;;
    esac

    if [ "$verbose" = "1" ]; then
        hide_unsupported=0
    elif [ "$report_limitations" = "1" ]; then
        hide_unsupported=1
    else
        hide_unsupported=2
    fi

    if ! rm -f -- "$stats_file"; then
        printf '%s: cannot remove old lint-sh statistics file: %s\n' \
               "$pgm_name" "$stats_file" >&2
        return 3
    fi

    LINT_SH_STATS_FILE="$stats_file" LC_ALL=C "$awk_pgm" \
        -v fname="$file" -v hide_unsupported="$hide_unsupported" \
        -f "$USRHOME_DIR/bin/other/lint-sh.awk" "$awk_file"
    awk_status=$?

    if [ "$awk_status" -gt 1 ] ||
           ! IFS=' ' read -r file_errors file_unsupported extra < "$stats_file"
    then
        printf '%s: AWK failed for %s\n' "$pgm_name" "$file" >&2
        return 4
    fi
    case $file_errors in
        ''|*[!0-9]*) printf '%s: invalid AWK statistics for %s\n' "$pgm_name" "$file" >&2; return 2 ;;
    esac
    case $file_unsupported in
        ''|*[!0-9]*) printf '%s: invalid AWK statistics for %s\n' "$pgm_name" "$file" >&2; return 2 ;;
    esac
    if [ -n "$extra" ]; then
        printf '%s: invalid AWK statistics for %s\n' "$pgm_name" "$file" >&2
        return 4
    fi

    internal_diagnostics=$((internal_diagnostics + file_errors))
    unsupported_diagnostics=$((unsupported_diagnostics + file_unsupported))
    if [ "$file_unsupported" -gt 0 ]; then
        unsupported_files=$((unsupported_files + 1))
    fi

    if [ "$shellcheck_failed" = "1" ]; then
        return 2
    fi
    if [ "$shellcheck_diags_found" = "1" ]; then
        return 1
    fi
    return "$awk_status"
}

# --
# Proceed with identified, valid targets

# Resolve the physical path of this script so it skips itself during directory scans
self_dir=$(CDPATH='' cd -P -- "$(dirname -- "$0")" 2>/dev/null && pwd -P)
self_path="$self_dir/$(basename -- "$0")"

lint_error_found=0

if [ -n "$target_file" ]; then
    # Audit the specified file
    #
    files_to_audit=$((files_to_audit + 1))
    audit_file "$target_file"
    audit_status=$?
    case $audit_status in
        0) ;;
        1) lint_error_found=1 ;;
        *) lint_error_found=2 ;;
    esac
    if [ ! "$lint_error_found" -gt 1 ]; then
        files_audited=$((files_audited + 1))
    fi
elif [ -n "$target_dir" ]; then
    # Audit all shell script in specified directory.
    #
    # Save the file list so the find status is not hidden by a pipeline.
    file_list=$(mktemp "${USRHOME_DIR_TMP:-${TMPDIR:-/tmp}}/lint-sh.XXXXXXXXXX") || {
        printf '%s: cannot create temporary file list\n' "$pgm_name" >&2
        exit 1
    }

    # Store a list of files to process into a temporary file
    printf "# Identifying files to audit...\n"
    # Skip macOS .DS_Store files,
    # Skip DVCS repos: Git, Got (Game of Trees), Mercurial, Jujutsu, Pijul, Unity DVCS (Plastic)
    # Skip Emacs backup and tmp files
    # Do not enter an excluded tree when the scan starts inside it.
    skip_excluded_tree=0
    if ! search_dir=$(CDPATH='' cd -P -- "$target_dir" && pwd -P); then
        printf '%s: cannot access directory: %s\n' "$pgm_name" "$target_dir" >&2
        lint_error_found=2
        skip_excluded_tree=1
    else
        case "$search_dir/" in
            */.bzr/*|*/_darcs/*|*/.git/*|*/.got/*|*/.hg/*|*/.jj/*|*/.pijul/*|*/.plastic/*|*/man/man[0-9]/*)
                skip_excluded_tree=1
                ;;
        esac
    fi

    if [ "$skip_excluded_tree" -eq 0 ] &&
        ! find "$target_dir" \
            \( -type d \( -name '.bzr' -o -name '_darcs' \
                -o -name '.git' -o -name '.got' -o -name '.hg' \
                -o -name '.jj' -o -name '.pijul' -o -name '.plastic' \
                -o -path '*/man/man[0-9]' -o -path 'man/man[0-9]' \) -prune \) -o \
            \( -type f ! -name '.DS_Store' \
            ! -path '*/.bzr/*' \
            ! -path '*/_darcs/*' \
            ! -path '*/.git/*' \
            ! -path '*/.got/*' \
            ! -path '*/.hg/*' \
            ! -path '*/.jj/*' \
            ! -path '*/.pijul/*' \
            ! -path '*/.plastic/*' \
            ! -name '*~' ! -name '.#*' \
            ! -name '*#' ! -name '#*' \
            ! -name '*.html' ! -name '*.asn' \
            ! -name '*.c' ! -name '*.h' ! -name '*.C' ! -name '*.H' \
            ! -name '*.cc' ! -name '*.cpp' ! -name '*.cxx' ! -name '*.c++' \
            ! -name '*.hh' ! -name '*.hpp' ! -name '*.hxx' ! -name '*.h++' \
            ! -name '*.ipp' ! -name '*.tpp' ! -name '*.inl' \
            ! -name '*.ixx' ! -name '*.cppm' \
            ! -name '*.erl' ! -name '*.hrl' ! -name '*.ex' ! -name '*.exs' ! -name '*.eix' \
            ! -name '*.d' ! -name '*.di' ! -name '*.go' \
            ! -name '*.py' ! -name '*.pyw' ! -name '*.pyi' \
            ! -name '*.rb' ! -name '*.rbw' ! -name '*.rake' ! -name '*.gemspec' ! -name '*.ru' \
            ! -name '*.el' ! -name '*.elc' \
            ! -name '*.lisp' ! -name '*.lsp' ! -name '*.cl' ! -name '*.asd' \
            ! -name '*.scm' ! -name '*.ss' ! -name '*.sld' ! -name '*.sls' ! -name '*.sps' ! -name '*.sch' \
            ! -name '*.gleam' ! -name '*.dart' ! -name '*.c3' ! -name '*.c3i' ! -name '*.c3t' ! -name '*.zig' \
            ! -name '*.java' \
            ! -name '*.js' ! -name '*.mjs' ! -name '*.cjs' ! -name '*.jsx' \
            ! -name '*.jl' \
            ! -name '*.hs' ! -name '*.lhs' ! -name '*.hsc' \
            ! -name '*.lfe' \
            ! -name '*.lua' \
            ! -name '*.m4' \
            ! -name '*.mod' ! -name '*.def' ! -name '*.m2' \
            ! -name '*.m3' ! -name '*.i3' ! -name '*.mg' ! -name '*.ig' \
            ! -name '*.mojo' \
            ! -name '*.nrx' \
            ! -name '*.nim' ! -name '*.nims' ! -name '*.nimble' \
            ! -name '*.m' ! -name '*.mm' \
            ! -name '*.ml' ! -name '*.mli' ! -name '*.mll' ! -name '*.mly' \
            ! -name '*.odin' \
            ! -name '*.pas' ! -name '*.pp' ! -name '*.p' \
            ! -name '*.pl' ! -name '*.pm' ! -name '*.pod' \
            ! -name '*.php' ! -name '*.phtml' ! -name '*.php3' \
            ! -name '*.php4' ! -name '*.php5' ! -name '*.phps' \
            ! -name '*.pony' \
            ! -name '*.pro' ! -name '*.prolog' \
            ! -name '*.purs' \
            ! -name '*.R' ! -name '*.r' \
            ! -name '*.rkt' \
            ! -name '*.re' ! -name '*.rei' \
            ! -name '*.reb' ! -name '*.r3' \
            ! -name '*.red' ! -name '*.reds' \
            ! -name '*.rex' ! -name '*.rexx' ! -name '*.rx' \
            ! -name '*.v' \
            ! -name '*.rs' \
            ! -name '*.shen' \
            ! -name '*.sd7' ! -name '*.s7i' \
            ! -name '*.swift' \
            ! -name '*.tcl' ! -name '*.tk' ! -name '*.tm' \
            ! -name '*.ts' ! -name '*.tsx' ! -name '*.mts' ! -name '*.cts' \
            ! -name '*.vala' ! -name '*.vapi' \
            ! -name '*.rst.txt' ! -name '*.md' ! -name '*.txt' ! -name '*.org' \
            ! -path '*/man/man[0-9]/*' ! -path 'man/man[0-9]/*' \
            -exec sh -c '
       status=0
       for candidate do
          # The file list uses newlines as separators.
          case "$candidate" in
            *"
"*)
              printf "%s: pathname contains a newline: %s\n" "$0" "$candidate" >&2
              status=1
              continue
              ;;
          esac

          # Prefix relative paths so file cannot interpret them as options.
          case "$candidate" in
            /*) probe_file=$candidate ;;
            *)  probe_file=./$candidate ;;
          esac
          if ! description=$(LC_ALL=C file -b "$probe_file"); then
            printf "%s: cannot classify %s\n" "$0" "$candidate" >&2
            status=1
            continue
          fi

          case "$description" in
            *[Tt][Ee][Xx][Tt]*)
              printf "%s\n" "$candidate" || exit 1
              ;;
          esac
        done
        exit "$status"
      ' "$pgm_name" {} + \) > "$file_list"; then
        lint_error_found=2
    fi
    # Then process the files.
    printf "# Auditing files...\n"
    printf "# ------------------------------------------\n"
    {
        while IFS= read -r file; do
            # Skip scanning the auditor script itself
            file_dir=$(CDPATH='' cd -P -- "$(dirname -- "$file")" 2>/dev/null && pwd -P)
            if [ "$file_dir/$(basename -- "$file")" = "$self_path" ]; then
                continue
            fi
            # Only inspect files with a shell extension or a shell shebang
            case "$file" in
                *.sh|*.bash|*.zsh) is_shell=1 ;;

                *)
                    # Prefix relative paths so file does not treat them as options.
                    case "$file" in
                        /*) probe_file=$file ;;
                        *)  probe_file=./$file ;;
                    esac

                    if ! file_type=$(LC_ALL=C file -b "$probe_file" 2>/dev/null); then
                        printf '%s: cannot classify %s\n' "$pgm_name" "$file" >&2
                        lint_error_found=3
                        continue
                    fi

                    case "$file_type" in
                        ELF*|Mach-O*|PE32*)
                            continue
                            ;;
                        'cannot open'*|'cannot read'*)
                            printf '%s: cannot classify %s: %s\n' \
                                   "$pgm_name" "$file" "$file_type" >&2
                            lint_error_found=4
                            continue
                            ;;
                    esac

                    # Prefix the result with T for text or N for a NUL-byte offset.
                    # Convert through od so no NUL reaches command substitution.
                    first_line_result=$(
                        head -n 1 "$file" 2>/dev/null |
                            LC_ALL=C od -A n -t u1 -v |
                            LC_ALL=C "$awk_pgm" '
            BEGIN { status = "T"; offset = 0 }
            {
                for (i = 1; i <= NF; i++) {
                    if (done) continue
                    byte = $i + 0
                    if (byte == 10) {
                        done = 1
                    } else if (byte == 0) {
                        status = "N"
                        done = 1
                    } else {
                        text = text sprintf("%c", byte)
                        offset++
                    }
                }
            }
            END {
                if (status == "N") printf "N%.0f", offset
                else printf "T%s", text
            }
        '
                                     )

                    case "$first_line_result" in
                        N*)
                            offset=${first_line_result#N}
                            printf '%s:1: [WARNING: NUL byte at byte column %s (zero-based file offset %s); file skipped]\n' \
                                   "$file" "$((offset + 1))" "$offset" >&2
                            continue
                            ;;
                        T*)
                            first_line=${first_line_result#T}
                            ;;
                        *)
                            printf '%s: [ERROR: could not inspect first line]\n' "$file" >&2
                            lint_error_found=5
                            continue
                            ;;
                    esac
                    case "$first_line" in
                        # Match shell path in the shebang line
                        '#!'*/sh*|'#!'*/bash*|'#!'*/zsh*|'#!'*' env sh'*|'#!'*' env bash'*|'#!'*' env zsh'*)
                            is_shell=1 ;;
                        *)
                            # Match env followed by a shell name, with
                            # optional -S and shell arguments.
                            if printf '%s\n' "$first_line" |
                                    grep -Eq \
                                         '^#![[:blank:]]*/([^[:blank:]]*/)?env[[:blank:]]+(-S[[:blank:]]+)?(sh|bash|zsh)([[:blank:]]|$)'
                            then
                                is_shell=1
                            else
                                if printf '%s\n' "$first_line" |
                                        grep -Eq \
                                             '^[[:blank:]]*#[[:blank:]]*Sourced[[:blank:]]+script:.*-\*-[[:blank:]]*mode:[[:blank:]]*(sh|bash|zsh)[[:blank:]]*;[[:blank:]]*-\*-'
                                then
                                    is_shell=1
                                else
                                    is_shell=0
                                fi
                            fi
                            ;;
                    esac
                    ;;
            esac
            if [ "$is_shell" -eq 1 ]; then
                files_to_audit=$((files_to_audit + 1))
                audit_file "$file"
                audit_status=$?
                case $audit_status in
                    0) ;;
                    1)
                        if [ "$lint_error_found" -eq 0 ]; then
                            lint_error_found=1
                        fi
                        ;;
                    *) lint_error_found=2 ;;
                esac
                if [ "$audit_status" -le 1 ]; then
                    files_audited=$((files_audited + 1))
                fi
            fi
            if [ "$terminate_processing" = "1" ]; then
                break
            fi
        done
} < "$file_list"
fi

printf "# ------------------------------------------\n"
printf '# %s: audited %s of %s candidate files.\n' "$pgm_name" "$files_audited" "$files_to_audit"
printf '# Internal diagnostics  : %s.\n' "$internal_diagnostics"
if [ "$with_shellcheck" = "1" ]; then
    printf '# ShellCheck diagnostics: %s.\n' "$shellcheck_diagnostics"
fi
printf '# Unsupported diagnostics: %s in %s files.\n' \
       "$unsupported_diagnostics" "$unsupported_files"

exit "$lint_error_found"

# ----------------------------------------------------------------------------
# Local Variables:
# sh-shell: sh
# End:
