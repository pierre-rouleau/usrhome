#!/bin/sh
# SH FILE: files-in
#
# Purpose   : List files in specified directory tree.
# Created   : Tuesday, June 11 2024.
# Author    : Pierre Rouleau <prouleau001@gmail.com>
# Time-stamp: <2026-11-09 12:26:30 EST, updated by Pierre Rouleau>
# ----------------------------------------------------------------------------
# Description
# -----------
#
# List files in a directory

# ----------------------------------------------------------------------------
# Dependencies
# ------------
#
# - find

# ----------------------------------------------------------------------------
# Code
# ----
#
#

print_usage()
{
    printf -- "
files-in - list files present in specified directory tree.
           Includes symbolic links and sub-directories.

 Usage: files-in [-l|--long] [DIRPATH]

   -l | --long : long display.
   DIRPATH     : Path of directory tree to inspect.
                 Defaults to current directory.

 Notes: To list only directories use the -l option
        and pipe the output to 'grep \"^d\"'.
        To list only the directory names in the current
        tree: do this:
              files-in -l | grep \"^d\" | awk '{print \$9 }'

"
}

# --
# validate arguments

if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    print_usage
    # help requested explicitly: no error.
    exit 0
fi

long_display=
if [ "$1" = "-l" ] || [ "$1" = --long ]; then
    long_display="true"
    shift
fi

if [ -z "$1" ]; then
    dirpath=.
else
    dirpath="$1"
fi
shift

# ---
# Define printing utilities:
# - usrhome_printf_warning FORMAT ARGS...
# - usrhome_printf_error   FORMAT ARGS...

# shellcheck source=../ibin/xtra/print-utilities.sh
. "$USRHOME_DIR/ibin/xtra/print-utilities.sh"
# ---

if [ -n "$2" ]; then
    usrhome_printf_error 'files-in: unexpected arguments: %s\n' "$*"
    usrhome_printf_stderr 'Use files-in -h to show usage.\n'
    exit 1
elif [ -n "$1" ]; then
    usrhome_printf_error 'files-in: unexpected argument: %s\n' "$1"
    usrhome_printf_stderr 'Use files-in -h to show usage.\n'
    exit 1
fi

if [ ! -d "$dirpath" ]; then
    usrhome_printf_error 'files-in: no such file or directory: %s\n' "$dirpath"
    exit 1
fi


# --
# proceed

list_files()
{
    find "$1" -type f -or -type l -or -type d -not -path "$1"
}

if [ "$long_display" = "true" ]; then
    list_files "$dirpath" | xargs -I $ ls -l -d $
else
    list_files "$dirpath"
fi

# ----------------------------------------------------------------------------
# Local Variables:
# sh-shell: sh
# End:
