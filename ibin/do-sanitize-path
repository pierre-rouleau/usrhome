# ----------------------------------------------------------------------------
# Module Description
# ------------------
#
# Bash/Zsh dispatcher to the do-sanitize-path script: fix issues in PATH value
# and report any detected problems.
#
# This script is mostly used by other scripts that modify the PATH to validate
# their changes and prevent problems.

# ----------------------------------------------------------------------------
# Dependencies
# ------------
#
#  USRHOME_SHELL environment variable set by startup scripts via $USRHOME/ibin/which-shell

# ----------------------------------------------------------------------------
# Code
# ----
#
#
# Using USRHOME_SHELL variable that USRHOME sets
case "${USRHOME_SHELL:-}" in
    zsh)
        if [ -f "${USRHOME_DIR}/ibin/do-sanitize-path.zsh" ]; then
            . "${USRHOME_DIR}/ibin/do-sanitize-path.zsh" || return 1
        else
            printf '%s\n' 'Missing do-sanitize-path.zsh; PATH was not sanitized.' >&2
            return 2
        fi
        ;;
    bash)
        if [ -f "${USRHOME_DIR}/ibin/do-sanitize-path.sh" ]; then
            . "${USRHOME_DIR}/ibin/do-sanitize-path.sh" "$@" || return 1
        else
            printf '%s\n' 'Missing do-sanitize-path.sh; PATH was not sanitized.' >&2
            return 2
        fi
        ;;

    sh|dash|ksh)
        if [ -f "${USRHOME_DIR}/ibin/do-sanitize-path.posix.sh" ] &&
           [ -r "${USRHOME_DIR}/ibin/do-sanitize-path.posix.sh" ]; then
            . "${USRHOME_DIR}/ibin/do-sanitize-path.posix.sh" || return 1
        else
            printf '%s\n' 'Missing or unreadable do-sanitize-path.posix.sh.' >&2
            return 2
        fi
    ;;
    *)
        printf 'do-sanitize-path: unsupported shell: %s\n' "${USRHOME_SHELL:-<unset>}" >&2
        return 2
        ;;
esac

