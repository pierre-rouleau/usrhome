# ----------------------------------------------------------------------------
# Module Description
# ------------------
#
# Set the prompt model to the number specified by the argument.
#
# This source script is meant to be executed as the command named:
#   usrhome-prompt-model-to
#
# The script $USRHOME_DIR/ibin/setfor-alias sets the alias.
#

# ----------------------------------------------------------------------------
# Dependencies
# ------------
#
#


# ----------------------------------------------------------------------------
# Code
# ----
#
#
# Topic: Prompt: Control
# ----------------------

print_status()
{
    if [ -n "$USRHOME_PROMPT_MODEL_OVERRIDE" ]; then
        usrhome_prinf '  Using overridden prompt model number: %s\n' "$USRHOME_PROMPT_MODEL_OVERRIDE"
    fi
    if [ -z "$USRHOME_PROMPT_MODEL" ]; then
        usrhome_print_warning '  The current prompt model number is undefined.'
    else
        usrhome_printf '  Shell configured prompt model number: %s\n' "$USRHOME_PROMPT_MODEL"
    fi
}

print_usage()
{
    printf "\
usrhome-prompt-model-to: Change prompt to another model. Print used model.

Usage:  usrhome-prompt-model-to -h|--help
        usrhome-prompt-model-to [MODEL-NUMBER
        usrhome-prompt-model-to current
        usrhome-prompt-model-to reset

    - MODEL-NUMBER: 0, 1, 2 or 3.
    - current     : print current prompt model.
    - reset       : restore prompt model select by configuration.
"
    print_status
}

# Validate user input
# ------------------
if [ -z "$1" ]; then
    usrhome_printf_error 'usrhome-prompt-model-to:  requires the prompt model number.
\t Use -h to print usage.\n'
    return 1
fi

case "$1" in
    --help | -h)
        print_usage
        return 0
        ;;


    # prevent any other option:
    # note that it also precludes having symlink names that start with a '-'
    -?* )
        usrhome_printf_error 'usrhome-prompt-model-to does not support the %s option.
\t Use -h to print usage.\n' "$1"
        return 1
        ;;

    current)
        print_status
        return 0
        ;;

    reset)
        # stop overriding if that was already overridden
        if [ -z "$USRHOME_PROMPT_MODEL_OVERRIDE" ]; then
            usrhome_printf 'The prompt model is already the one selected by configuration: %s
\t Nothing to do.\n' "$USRHOME_PROMPT_MODEL"
            return 0
        else
            if [ "$USRHOME_PROMPT_MODEL_OVERRIDE" = "$USRHOME_PROMPT_MODEL" ]; then
                usrhome_printf 'Overridden prompt model is the same as the one selected by configuration: %s\n' "$USRHOME_PROMPT_MODEL"
                unset USRHOME_PROMPT_MODEL_OVERRIDE
                usrhome_printf 'Overriding cancelled, nothing else to do.\n'
                return 0
            else
                # shellcheck source=xtra/confirm-shell-restart.sh
                . "$USRHOME_DIR/ibin/xtra/confirm-shell-restart.sh" || return 1
                usrhome_prompt_restart_preflight "${USRHOME_PROMPT_MODEL-}" || return 1

                usrhome_printf 'Restoring configuration requested prompt model: %s\n' "$USRHOME_PROMPT_MODEL"
                unset USRHOME_PROMPT_MODEL_OVERRIDE
            fi
        fi
        ;;

    0 | 1 | 2 | 3)
        # shellcheck source=xtra/confirm-shell-restart.sh
        . "$USRHOME_DIR/ibin/xtra/confirm-shell-restart.sh" || return 1
        usrhome_prompt_restart_preflight "$1" || return 1
        export USRHOME_PROMPT_MODEL_OVERRIDE="$1"
        ;;

    *)
    usrhome_printf_error 'invalid prompt number: %s\n' "$1"
    print_usage
    return 1
esac

# ----------------------------------------------------------------------------
# Proceed, using method required by shell
# ---------------------------------------

# shellcheck source=./change_prompt
. "$USRHOME_DIR/ibin/change_prompt"

