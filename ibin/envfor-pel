# ----------------------------------------------------------------------------
# Module Description
# ------------------
#
# Set the environment for programming PEL.

# ----------------------------------------------------------------------------
# Dependencies
# ------------
#
# - This should be invoked via an alias named pel
# - $USRHOME_DIR/bin must be on PATH.  It holds set_title.

# ----------------------------------------------------------------------------
# Code
# ----
#
# Note: The precautions in this code to ensure that USRHOME_DIR_PUBLIC is set
#       exit mainly to silence the various shell script checkers.  They are
#       not really required since this script is normally invoked through an
#       alias that requires the proper value of USRHOME_DIR_PUBLIC as
#       described in the dependencies.  If USRHOME_DIR_PUBLIC is not set
#       properly most USRHOME utilities will fail anyway.


if [ -n "$USRHOME_DIR_PUBLIC" ]; then
    _usrhome__target_dir="${USRHOME_DIR_PUBLIC:-$HOME}"
    cd -- "${_usrhome__target_dir}/elisp/pel/$1" || return 1
    unset _usrhome__target_dir
    set_title PEL
else
    printf "ERROR: USRHOME_DIR_PUBLIC is not set!!\n" >&2
    return 1
fi

