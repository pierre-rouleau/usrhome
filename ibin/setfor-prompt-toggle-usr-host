# Sourced script: setfor-prompt-toggle-usr-host  -*- mode: sh; -*-
#
# Purpose   : Toggle showing host and user name in the prompt.
# Created   : Tuesday, March 26 2024.
# Author    : Pierre Rouleau <prouleau001@gmail.com>
# Time-stamp: <2026-11-12 22:09:45 EST, updated by Pierre Rouleau>
# ----------------------------------------------------------------------------
# Module Description
# ------------------
#
# Toggle showing the host name and user name on the Zsh prompt.

# ----------------------------------------------------------------------------
# Code
# ----
#
#

# shellcheck source=xtra/confirm-shell-restart.sh
. "$USRHOME_DIR/ibin/xtra/confirm-shell-restart.sh" || return 1
usrhome_prompt_restart_preflight "${USRHOME_PROMPT_MODEL_OVERRIDE:-${USRHOME_PROMPT_MODEL-}}" || return 1

if [ -z "$USRHOME_PROMPT_SHOW_USR_HOST" ]; then
    export USRHOME_PROMPT_SHOW_USR_HOST=1
else
    if [ "$USRHOME_PROMPT_SHOW_USR_HOST" = 0 ]; then
        export USRHOME_PROMPT_SHOW_USR_HOST=1
    else
        export USRHOME_PROMPT_SHOW_USR_HOST=0
    fi
fi

if [ "$USRHOME_PROMPT_SHOW_USR_HOST" = 0 ]; then
    usrhome_printf 'Prompt no longer shows host and user name.\n'
else
    usrhome_printf 'Prompt now shows host and user name.\n'
fi

# Proceed, using method required by shell
# ---------------------------------------

# shellcheck source=./change_prompt
. "$USRHOME_DIR/ibin/change_prompt"


