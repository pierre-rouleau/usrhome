# Sourced script: do-cbr  -*- mode: sh; -*-
#
# Purpose   : Compatibility wrapper for CBR as it was implemented in the past.
# Created   : Sunday, April 14 2024.
# Author    : Pierre Rouleau <prouleau001@gmail.com>
# Time-stamp: <2026-11-12 10:10:29 EST, updated by Pierre Rouleau>
# ----------------------------------------------------------------------------
# Module Description
# ------------------
#
# Compatibility wrapper for callers of the former do-cbr script.
#
# The first argument must be c, b, or r. Any remaining arguments are
# passed to the selected CBR function.
#
# USRHOME_DIR must identify the USRHOME installation.

(
    # Keep the loaded functions, aliases, and temporary variables out of
    # the calling shell.
    if [ -z "${USRHOME_DIR-}" ] ||
       [ ! -r "$USRHOME_DIR/ibin/xtra/print-utilities.sh" ] ||
       [ ! -r "$USRHOME_DIR/ibin/envfor-cbr" ]; then
        # The shared print functions might not be available yet.
        case "$-" in
            *i*)
                if [ "${TERM-}" != dumb ]; then
                    printf '%s\n' \
                        'do-cbr: USRHOME_DIR or a required file is missing.' >&2
                fi
                ;;
        esac
        exit 1
    fi

    # The print functions access TERM directly.
    TERM=${TERM-}

    # shellcheck source=xtra/print-utilities.sh
    . "$USRHOME_DIR/ibin/xtra/print-utilities.sh" || exit 1

    # Do not print the alias-installation message from the wrapper.
    # shellcheck source=./envfor-cbr
    . "$USRHOME_DIR/ibin/envfor-cbr" > /dev/null || exit 1

    case "${1-}" in
        c) shift; _usrhome_c "$@" ;;
        b) shift; _usrhome_b "$@" ;;
        r) shift; _usrhome_r "$@" ;;
        *)
            usrhome_printf_error 'cbr: invalid arg: %s\nUsage: c|b|r\n' "${1-}"
            exit 1
            ;;
    esac
)
